# Same line endings on every laptop (Windows, macOS, Linux): store LF in the repo.
* text=auto eol=lf

# Windows scripts keep Windows line endings
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never touch
*.png     binary
*.jpg     binary
*.gif     binary
*.pdf     binary
*.zip     binary
*.db      binary
*.joblib  binary
