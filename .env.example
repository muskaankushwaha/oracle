# Copy this file to .env and edit. The real .env is never committed.

# Optional RAG-grounded explanations: none | gemini | ollama
# none keeps all processing local. Gemini receives issue details and retrieved, redacted excerpts.
# Ollama sends excerpts to the local Ollama server on this computer.
LLM_PROVIDER=none

# Only needed for Gemini. Never paste this key into a chat or commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Ollama must be installed and running when selected.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434

# Where make_demo_repo.py builds the buggy eshop (ignored by Git)
DEMO_REPO_PATH=workspace/eshop

# SQLite file for investigations and the audit log
DB_PATH=oracle.db

# Seconds before run_tests gives up
TEST_TIMEOUT_S=60
