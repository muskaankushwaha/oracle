# Copy this file to .env and edit. The real .env is never committed.

# Which LLM rewrites the final summary: none | gemini | ollama
# "none" fills a sentence template and needs no internet. The diagnosis never depends on the LLM.
LLM_PROVIDER=none

# Only needed when LLM_PROVIDER=gemini. Never paste this key into a chat or commit it.
GEMINI_API_KEY=

# Only needed when LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434

# Where make_demo_repo.py builds the buggy eshop (ignored by Git)
DEMO_REPO_PATH=workspace/eshop

# SQLite file for investigations and the audit log
DB_PATH=oracle.db

# Seconds before run_tests gives up
TEST_TIMEOUT_S=60
